{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hix.invalid/schemas/hix.review.v2.schema.json",
  "title": "hix.review/v2",
  "description": "Aggregate review report written as review.json at the root of a review output directory. It doubles as the marker file that authorizes replacing a previous review output. Entries of `skills`, `agents`, and `capabilities` are whole review subjects; this schema constrains only the keys the aggregate report itself guarantees, because each subject is additionally validated against hix.skill-review/v1 or hix.agent-review/v1.",
  "type": "object",
  "required": ["schema", "endpoint", "selection", "summary", "skills", "agents", "capabilities", "handoff"],
  "properties": {
    "schema": { "const": "hix.review/v2" },
    "endpoint": {
      "type": "object",
      "required": ["spec", "participant", "scope", "behavior"],
      "properties": {
        "spec": { "type": "string" },
        "participant": { "type": "string" },
        "scope": { "type": "string" },
        "behavior": { "enum": ["claude", "open-agent-skills", "neutral", "unknown"] }
      },
      "additionalProperties": false
    },
    "selection": {
      "type": "object",
      "required": ["requestedSkills", "all", "discovered", "reviewed"],
      "properties": {
        "requestedSkills": { "type": "array", "items": { "type": "string" } },
        "all": { "type": "boolean" },
        "discovered": {
          "type": "object",
          "required": ["skills", "agents"],
          "properties": {
            "skills": { "type": "array", "items": { "type": "string" } },
            "agents": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": false
        },
        "reviewed": {
          "type": "object",
          "required": ["skills", "agents"],
          "properties": {
            "skills": { "type": "array", "items": { "type": "string" } },
            "agents": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "required": ["subjects", "capabilities", "skills", "agents", "ready", "needs-review", "blocked", "findings"],
      "properties": {
        "subjects": { "type": "integer", "minimum": 0 },
        "capabilities": { "type": "integer", "minimum": 0 },
        "skills": { "type": "integer", "minimum": 0 },
        "agents": { "type": "integer", "minimum": 0 },
        "ready": { "type": "integer", "minimum": 0 },
        "needs-review": { "type": "integer", "minimum": 0 },
        "blocked": { "type": "integer", "minimum": 0 },
        "findings": {
          "type": "object",
          "description": "Finding counts accumulated across every subject, keyed by severity. Empty when no subject was reviewed, so no severity key is required.",
          "properties": {
            "error": { "type": "integer", "minimum": 0 },
            "warning": { "type": "integer", "minimum": 0 },
            "info": { "type": "integer", "minimum": 0 },
            "pass": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "skills": {
      "type": "array",
      "description": "Skill review subjects. Each is validated in full against hix.skill-review/v1.",
      "items": {
        "type": "object",
        "required": ["schema", "kind", "id", "status", "findings"],
        "properties": {
          "schema": { "const": "hix.skill-review/v1" },
          "kind": { "const": "skill" },
          "id": { "type": "string" },
          "status": { "enum": ["ready", "needs-review", "blocked"] },
          "findings": { "type": "array", "minItems": 1 }
        },
        "additionalProperties": true
      }
    },
    "agents": {
      "type": "array",
      "description": "Native agent review subjects. Each is validated in full against hix.agent-review/v1.",
      "items": {
        "type": "object",
        "required": ["schema", "kind", "id", "status", "findings"],
        "properties": {
          "schema": { "const": "hix.agent-review/v1" },
          "kind": { "const": "agent" },
          "id": { "type": "string" },
          "status": { "enum": ["ready", "needs-review", "blocked"] },
          "findings": { "type": "array", "minItems": 1 }
        },
        "additionalProperties": true
      }
    },
    "capabilities": {
      "type": "array",
      "description": "Every subject of either kind, in skills-then-agents order. Skills and native agents are peer review subjects.",
      "items": {
        "type": "object",
        "required": ["schema", "kind", "id", "status", "findings"],
        "properties": {
          "schema": { "enum": ["hix.skill-review/v1", "hix.agent-review/v1"] },
          "kind": { "enum": ["skill", "agent"] },
          "id": { "type": "string" },
          "status": { "enum": ["ready", "needs-review", "blocked"] },
          "findings": { "type": "array", "minItems": 1 }
        },
        "additionalProperties": true
      }
    },
    "handoff": {
      "type": "object",
      "description": "LLM-ready brief derived from the subjects, rendered separately as handoff.md.",
      "required": ["purpose", "sourceEndpoint", "sourceParticipant", "instructions", "subjects"],
      "properties": {
        "purpose": { "type": "string" },
        "sourceEndpoint": { "type": "string" },
        "sourceParticipant": { "type": "string" },
        "instructions": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "subjects": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["kind", "id", "status", "hash", "tasks"],
            "properties": {
              "kind": { "enum": ["skill", "agent"] },
              "id": { "type": "string" },
              "status": { "enum": ["ready", "needs-review", "blocked"] },
              "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              "tasks": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["id", "instruction", "evidence"],
                  "properties": {
                    "id": { "type": "string" },
                    "instruction": { "type": "string" },
                    "evidence": { "type": "array", "items": { "type": "string" } }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
